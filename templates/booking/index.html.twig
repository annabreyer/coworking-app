{% extends 'base.html.twig' %}

{% block title %}{{ 'booking.page.title'|trans }}{% endblock %}
{% block header %}{{ 'booking.page.title'|trans }}{% endblock %}

{% block content  %}
    {% include 'booking/partials/step_bar.html.twig' with {'currentStep': 1} %}

    {% if step == 1 %}
        <section class="w-full max-w-2xl mx-auto">
            <p class="text-lg text-center">{{ 'booking.page.days.intro'|trans }}</p>

            {% if dayOverview is empty %}
                <p class="text-lg text-center">{{ 'booking.page.days.none'|trans }}</p>
            {% else %}
                <ul class="flex flex-col gap-3" id="day-list">
                    {% for day in dayOverview %}
                        {% set businessDay = day.businessDay %}
                        <li class="grid grid-cols-[1fr_auto] sm:flex items-center gap-x-4 gap-y-2 p-4 rounded-lg border border-silverpink bg-yellow-light/50 day-card">
                            <div class="flex flex-col min-w-[9rem]">
                                <span class="text-xl font-MiamoRegular">
                                    {{ ('booking.weekday.' ~ businessDay.weekDayShort)|trans }} {{ businessDay.date|date('d.m.') }}
                                </span>
                                {% if businessDay.date|date('Y-m-d') == today %}
                                    <span class="text-sm font-bold text-red">{{ 'booking.page.days.today'|trans }}</span>
                                {% endif %}
                            </div>
                            <div class="col-span-2 row-start-2 flex items-center gap-2 grow">
                                <span class="flex gap-1" aria-hidden="true">
                                    {% for i in 1..max(day.capacity, 1) %}
                                        <span class="w-3 h-3 rounded-full border border-red {{ i <= day.bookingCount ? 'bg-red' }}"></span>
                                    {% endfor %}
                                </span>
                                <span class="text-base">
                                    {% if not day.isAvailable %}
                                        {{ 'booking.page.days.full'|trans }}
                                    {% elseif day.bookingCount == 0 %}
                                        {{ 'booking.page.days.empty'|trans({'%capacity%': day.capacity}) }}
                                    {% else %}
                                        {{ 'booking.page.form.room.capacity'|trans({'%capacity%': day.capacity, '%bookings%': day.bookingCount}) }}
                                    {% endif %}
                                </span>
                            </div>
                            <div class="col-start-2 row-start-1">
                            {% if not day.isAvailable %}
                                <button type="button" disabled class="!bg-silverpink !text-silverpink-darkest cursor-not-allowed !my-0">
                                    {{ 'booking.page.days.full'|trans }}
                                </button>
                            {% elseif day.singleRoomId %}
                                <form method="post" action="{{ path('booking_step_room', {'businessDay': businessDay.id}) }}">
                                    <input type="hidden" name="room" value="{{ day.singleRoomId }}">
                                    <input type="hidden" name="token" value="{{ csrf_token('room') }}">
                                    <button type="submit" class="!my-0 text-lg">{{ 'booking.page.form.action'|trans }}</button>
                                </form>
                            {% else %}
                                <a href="{{ path('booking_step_room', {'businessDay': businessDay.id}) }}">
                                    <button type="button" class="!my-0 text-lg">{{ 'booking.page.days.choose'|trans }}</button>
                                </a>
                            {% endif %}
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}

            <details class="mt-6 p-4 rounded-lg border border-silverpink" {{ dayOverview is empty ? 'open' }}>
                <summary class="cursor-pointer text-xl font-MiamoRegular">{{ 'booking.page.days.other_date'|trans }}</summary>
                <form id="form-date" method="post" action="{{ path('booking_step_date') }}" class="mt-4 flex flex-col sm:flex-row sm:items-end gap-4">
                    <div class="flex flex-col grow">
                        <label for="date">{{ 'booking.page.form.date.label'|trans }}</label>
                        <input type="date" id="date" name="date" required
                               max="{{ lastDay }}"
                               min="{{ firstDay }}"
                               class="text-gray-900 bg-gray-50 rounded-lg block w-full p-2.5 border border-gray-300 focus:z-10 focus:ring-yellow focus:border-yellow text-lg font-Helvetica"
                        >
                    </div>
                    <input type="hidden" name="token_date" value="{{ csrf_token('date') }}">
                    <button type="submit" class="!my-0 text-lg">{{ 'booking.page.form.next'|trans }}</button>
                </form>
            </details>
        </section>
    {% endif %}

    {% if step == 2 %}
        <section class="w-full max-w-2xl mx-auto">
            <div class="p-4 rounded-lg border border-silverpink bg-yellow-light/50">
                <p class="text-xl font-MiamoRegular my-0">
                    {{ ('booking.weekday.' ~ businessDay.weekDayShort)|trans }} {{ businessDay.date|date('d.m.Y') }}
                </p>
                <a href="{{ path('booking_step_date') }}" id="change-day" class="underline">{{ 'booking.page.days.change'|trans }}</a>
            </div>

            <form id="form-room" method="post" action="{{ path('booking_step_room', {'businessDay': businessDay.id}) }}" class="mt-4">
                {% if bookingOption|length == 1 %}
                    {% set option = bookingOption|first %}
                    <input type="hidden" name="room" value="{{ option.roomId }}">
                    <p class="text-lg">
                        {% if not option.isAvailable %}
                            {{ 'booking.page.days.full'|trans }}
                        {% elseif option.bookingCount == 0 %}
                            {{ 'booking.page.days.empty'|trans({'%capacity%': option.capacity}) }}
                        {% else %}
                            {{ 'booking.page.form.room.capacity'|trans({'%capacity%': option.capacity, '%bookings%': option.bookingCount}) }}
                        {% endif %}
                    </p>
                {% else %}
                    <div class="grid grid-cols-1">
                        <label for="room">{{ 'booking.page.form.room.label'|trans }}</label>
                        <select id="room" name="room" class="text-gray-900 bg-gray-50 rounded-lg block w-full p-2.5 border border-gray-300 focus:z-10 focus:ring-yellow focus:border-yellow text-lg font-Helvetica">
                            {% for option in bookingOption %}
                                <option value="{{ option.roomId }}" {{ option.isAvailable ? '': 'disabled' }} >
                                    {{ option.roomName }} ({{ 'booking.page.form.room.capacity'|trans({'%capacity%': option.capacity, '%bookings%': option.bookingCount}) }})
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                {% endif %}
                <input type="hidden" name="token" value="{{ csrf_token('room') }}">
                {% if bookingOption|length > 1 or (bookingOption|first).isAvailable %}
                    <button type="submit" class="text-lg">{{ 'booking.page.form.action'|trans }}</button>
                {% endif %}
            </form>
        </section>
    {% endif %}

    <section class="mt-20">
        <h2 class="text-center">{{ 'booking.page.prices.title'|trans }}</h2>
        <div class="self-center grid grid-cols-1 md:grid-cols-3 space-x-4 space-y-4">
        {% for price in prices %}
            {%  if price.isVoucher %}
                <div class="block self-auto max-w-sm p-6 rounded-lg shadow bg-red border border-red-dark">
                        <h3 class="my-2 font-bold tracking-tight text-yellow-lightest">{{ price.name }}</h3>
                        <h3 class="mt-1 mb-2 font-normal text-yellow-lightest "> {{ price.amount/100 }} €</h3>
                        <a href="{{ path('voucher_index') }}">
                            <span class="inline-flex items-center p-2 text-lg font-medium text-center text-red-darkest bg-yellow rounded-lg hover:bg-yellow-light focus:ring-4 focus:outline-none focus:ring-yellow">
                            {{ 'booking.page.prices.voucher_card.link'|trans }}
                                <svg class="rtl:rotate-180 w-3.5 h-3.5 ms-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 5h12m0 0L9 1m4 4L9 9"/>
                                </svg>
                            </span>
                        </a>
                </div>
            {%  elseif price.isUnitary %}
                <div class="block max-w-sm p-6 rounded-lg shadow bg-red border border-red-dark">
                    <h3 class="my-2 font-bold tracking-tight text-yellow-lightest">{{ price.name }} {{ price.amount/100 }} €</h3>
                    <p class="font-normal text-yellow-lightest">{{ 'booking.page.prices.unitary.explanation'|trans }}</p>
                </div>
            {% elseif price.isSubscription %}
                <div class="block max-w-sm p-6 rounded-lg shadow bg-red border border-red-dark">
                    <h3 class="my-2 text-2xl font-bold tracking-tight text-yellow-lightest">{{ price.name }} {{ price.amount/100 }} €</h3>
                    <p class="font-normal text-yellow-lightest">{{ 'booking.page.prices.subscription.explanation'|trans }}</p>

                </div>
            {%  endif %}
        {% endfor %}
    </div>
    </section>
{% endblock %}
